<script>
const PHOTO = '';
document.getElementById('profile-img').src = 'data:image/jpeg;base64,' + PHOTO;

const leads = [
  {name:'Mariana López',co:'Fintech SRL',stage:'prospecting',score:'72',initials:'ML'},
  {name:'Carlos Bentín',co:'LegalTech UY',stage:'prospecting',score:'61',initials:'CB'},
  {name:'Sofía Ríos',co:'Digital Bank',stage:'qualified',score:'88',initials:'SR'},
  {name:'Diego Moran',co:'Cumplo Labs',stage:'qualified',score:'79',initials:'DM'},
  {name:'Valentina Cruz',co:'TechCorp SA',stage:'proposal',score:'91',initials:'VC'},
  {name:'Andrés Ponce',co:'RegSoft',stage:'closed',score:'95',initials:'AP'},
];
let currentFilter='all';
let leadStates=leads.map(l=>({...l}));

function renderLeads(){
  const list=document.getElementById('lead-list');
  const filtered=currentFilter==='all'?leadStates:leadStates.filter(l=>l.stage===currentFilter);
  const nxt={prospecting:'qualified',qualified:'proposal',proposal:'closed',closed:null};
  list.innerHTML=filtered.map(lead=>{
    const n=nxt[lead.stage];
    const btn=n?`<button class="move-btn" onclick="moveLead('${lead.name}')">→ ${n}</button>`:'<span style="font-size:10px;color:var(--success);font-family:DM Mono,monospace;">✓ WON</span>';
    return `<div class="lead-item"><div class="lead-avatar">${lead.initials}</div><div class="lead-info"><div class="lead-name">${lead.name}</div><div class="lead-co">${lead.co} · <span style="font-family:DM Mono,monospace;font-size:10px;color:var(--muted)">${lead.stage}</span></div></div><div class="lead-score">${lead.score}%</div>${btn}</div>`;
  }).join('');
  updateCounts();
}

function moveLead(name){
  const nxt={prospecting:'qualified',qualified:'proposal',proposal:'closed'};
  const lead=leadStates.find(l=>l.name===name);
  if(lead&&nxt[lead.stage]){lead.stage=nxt[lead.stage];renderLeads();}
}

function filterStage(stage,e){
  currentFilter=stage;
  document.querySelectorAll('.stage').forEach(s=>s.classList.remove('active-stage'));
  e.currentTarget.classList.add('active-stage');
  renderLeads();
}

function updateCounts(){
  document.getElementById('cnt-all').textContent=leadStates.length;
  document.getElementById('cnt-p').textContent=leadStates.filter(l=>l.stage==='prospecting').length;
  document.getElementById('cnt-q').textContent=leadStates.filter(l=>l.stage==='qualified').length;
  document.getElementById('cnt-pr').textContent=leadStates.filter(l=>l.stage==='proposal').length;
  document.getElementById('cnt-c').textContent=leadStates.filter(l=>l.stage==='closed').length;
}
renderLeads();

function showDemo(which){
  document.querySelectorAll('.demo-panel').forEach(p=>p.classList.remove('visible'));
  document.querySelectorAll('.pillar').forEach(p=>p.classList.remove('active'));
  document.getElementById('demo-'+which).classList.add('visible');
  document.getElementById('p-'+which).classList.add('active');
}

function selectOpt(btn,verdict){
  document.querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  document.querySelectorAll('.verdict-box').forEach(v=>v.classList.remove('show'));
  document.getElementById('v-'+verdict).classList.add('show');
}

const aiLogs={
  email:['> Analyzing communication history for 47 leads...','> Detecting response patterns and optimal timing...','> Generating personalized follow-up sequences...','> Pipeline connected. Automation active.','> Estimated savings: 2h 40min per day ✓'],
  proposals:['> Loading base proposal template...','> Extracting CRM data: industry, size, detected pain points...','> Adapting tone and scope to prospect profile...','> Proposal generated and ready for review.','> Preparation time: 15 minutes ✓'],
  crm:['> Parsing meeting notes and emails...','> Extracting actions, dates and commitments...','> Updating fields in HubSpot automatically...','> CRM synced. 0 manual entries.','> Estimated savings: 40 minutes per day ✓'],
  content:['> Analyzing trends in fintech/legaltech sector...','> Generating 5 content variations per platform...','> Adapting tone for LinkedIn, Instagram, newsletter...','> 4-week editorial calendar ready.','> Total time: 30 minutes vs 4 hours ✓']
};

function optimizeProcess(el,id){
  const log=document.getElementById('ai-log');
  log.classList.add('show');log.innerHTML='';
  el.classList.add('optimizing');
  const lines=aiLogs[id];let i=0;
  const iv=setInterval(()=>{
    if(i<lines.length){log.innerHTML+=lines[i]+'<br>';i++;}
    else{clearInterval(iv);el.classList.remove('optimizing');el.classList.add('done');}
  },500);
}
</script>
