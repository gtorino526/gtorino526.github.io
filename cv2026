<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Giuliana Torino — Interactive CV</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --cream:#F5F0E8;--ink:#1A1A18;--gold:#C9A84C;--gold-light:#E8D5A0;
  --muted:#6B6860;--rule:rgba(26,26,24,0.12);--active-bg:rgba(201,168,76,0.08);
  --panel-bg:#FDFAF4;--success:#2D6A4F;--tag-bg:rgba(201,168,76,0.15);
}
body{background:var(--cream);font-family:'DM Sans',sans-serif;color:var(--ink);min-height:100vh}
.cv-shell{max-width:820px;margin:0 auto;padding:2rem 1.5rem 4rem}
.cv-header{display:grid;grid-template-columns:auto 1fr auto;gap:1.5rem;align-items:center;padding-bottom:1.5rem;border-bottom:0.5px solid var(--rule);margin-bottom:2rem}
.cv-photo{width:84px;height:84px;border-radius:50%;overflow:hidden;border:2px solid var(--gold-light);flex-shrink:0;background:var(--tag-bg)}
.cv-photo img{width:100%;height:100%;object-fit:cover;object-position:center 8%}
.cv-title{font-family:'Playfair Display',serif;font-size:36px;font-weight:400;letter-spacing:-0.5px;line-height:1.1}
.cv-title em{font-style:italic;color:var(--muted);font-size:18px;display:block;margin-top:4px;font-family:'Playfair Display',serif}
.cv-contact{text-align:right;font-size:12px;color:var(--muted);line-height:2;font-family:'DM Mono',monospace}
.cv-contact a{color:var(--gold);text-decoration:none}
.section-label{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem;display:flex;align-items:center;gap:8px}
.section-label::after{content:'';flex:1;height:0.5px;background:var(--rule)}
.pillars-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:0.5px solid var(--rule);border-radius:8px;overflow:hidden;margin-bottom:2rem}
.pillar{background:var(--panel-bg);padding:1.25rem;cursor:pointer;transition:background 0.2s;position:relative}
.pillar:hover,.pillar.active{background:var(--active-bg)}
.pillar.active::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--gold)}
.pillar-icon{font-size:20px;margin-bottom:8px;display:block}
.pillar-name{font-family:'Playfair Display',serif;font-size:15px;font-weight:600;margin-bottom:4px}
.pillar-sub{font-size:11px;color:var(--muted);line-height:1.4;margin-bottom:8px}
.pillar-tag{display:inline-block;font-size:10px;font-family:'DM Mono',monospace;background:var(--tag-bg);color:var(--gold);padding:2px 8px;border-radius:3px;letter-spacing:0.05em}
.tab-hint{font-size:11px;color:var(--gold);text-align:center;margin-bottom:1rem;font-family:'DM Mono',monospace}
.demo-panel{background:var(--panel-bg);border:0.5px solid var(--rule);border-radius:8px;margin-bottom:2rem;overflow:hidden;display:none}
.demo-panel.visible{display:block}
.demo-panel-header{background:var(--ink);color:var(--cream);padding:0.75rem 1.25rem;display:flex;align-items:center;gap:10px;font-family:'DM Mono',monospace;font-size:12px}
.dots{display:flex;gap:5px}
.dot{width:8px;height:8px;border-radius:50%}
.dot-r{background:#FF5F57}.dot-y{background:#FEBC2E}.dot-g{background:#28C840}
.demo-panel-title{flex:1;text-align:center;opacity:0.7;letter-spacing:0.06em}
.demo-body{padding:1.5rem}
.law-scene{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.case-card{border:0.5px solid var(--rule);border-radius:6px;padding:1rem;background:white;font-size:13px}
.case-card h4{font-family:'Playfair Display',serif;font-size:13px;margin-bottom:6px}
.case-card p{color:var(--muted);font-size:12px;line-height:1.5;margin-bottom:8px}
.analysis-area{grid-column:1/-1;border:0.5px solid var(--gold-light);border-radius:6px;padding:1rem;background:rgba(201,168,76,0.04)}
.analysis-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--gold);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px}
.option-row{display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap}
.opt-btn{border:0.5px solid var(--rule);background:white;border-radius:4px;padding:6px 12px;font-size:12px;cursor:pointer;font-family:'DM Sans',sans-serif;color:var(--ink);transition:all 0.15s}
.opt-btn:hover{border-color:var(--gold);color:var(--gold)}
.opt-btn.selected{background:var(--gold);color:white;border-color:var(--gold)}
.verdict-box{margin-top:10px;padding:10px;border-radius:4px;font-size:12px;line-height:1.6;display:none}
.verdict-box.show{display:block}
.verdict-ok{background:rgba(45,106,79,0.08);color:#1a4a36;border-left:2px solid var(--success)}
.verdict-warn{background:rgba(201,168,76,0.1);color:#6b4c00;border-left:2px solid var(--gold)}
.pipeline{display:flex;gap:0;margin-bottom:1rem;border:0.5px solid var(--rule);border-radius:6px;overflow:hidden}
.stage{flex:1;text-align:center;padding:8px 4px;font-size:11px;font-family:'DM Mono',monospace;background:white;border-right:0.5px solid var(--rule);cursor:pointer;transition:background 0.15s}
.stage:last-child{border-right:none}
.stage.active-stage{background:var(--active-bg);color:var(--gold)}
.stage .count{font-size:18px;font-weight:500;color:var(--ink);display:block;margin-bottom:2px}
.lead-list{display:flex;flex-direction:column;gap:6px}
.lead-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border:0.5px solid var(--rule);border-radius:5px;background:white;font-size:12px}
.lead-avatar{width:28px;height:28px;border-radius:50%;background:var(--tag-bg);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:var(--gold);flex-shrink:0}
.lead-info{flex:1}
.lead-name{font-weight:500;font-size:12px}
.lead-co{font-size:11px;color:var(--muted)}
.lead-score{font-family:'DM Mono',monospace;font-size:11px;color:var(--success);background:rgba(45,106,79,0.08);padding:2px 7px;border-radius:3px}
.move-btn{font-size:10px;border:0.5px solid var(--rule);background:white;border-radius:3px;padding:2px 8px;cursor:pointer;color:var(--muted);font-family:'DM Sans',sans-serif;transition:all 0.15s}
.move-btn:hover{border-color:var(--gold);color:var(--gold)}
.ai-interface{display:grid;grid-template-columns:1fr;gap:12px}
.process-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.process-card{border:0.5px solid var(--rule);border-radius:5px;padding:12px;background:white;font-size:11px;cursor:pointer;transition:border-color 0.15s}
.process-card:hover{border-color:var(--gold-light)}
.process-card.optimizing{border-color:var(--gold);animation:pulse 1s infinite}
@keyframes pulse{0%,100%{border-color:var(--gold)}50%{border-color:var(--gold-light)}}
.process-card h5{font-weight:500;margin-bottom:6px;font-size:13px;color:var(--ink)}
.process-card .time-before{color:var(--muted);font-size:11px}
.process-card .time-after{color:var(--success);font-weight:500;display:none;font-size:11px}
.process-card .savings-tag{display:none;margin-top:4px;font-size:10px;background:rgba(45,106,79,0.1);color:var(--success);padding:2px 6px;border-radius:3px;font-family:'DM Mono',monospace}
.process-card.done .time-before{text-decoration:line-through}
.process-card.done .time-after{display:block}
.process-card.done .savings-tag{display:inline-block}
.output-log{border:0.5px solid var(--rule);border-radius:5px;background:var(--ink);color:#A8E6CF;padding:12px;font-family:'DM Mono',monospace;font-size:11px;line-height:1.8;min-height:80px;display:none}
.output-log.show{display:block}
.exp-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2rem}
.exp-item{border:0.5px solid var(--rule);border-radius:6px;padding:1rem;background:var(--panel-bg)}
.exp-co{font-family:'DM Mono',monospace;font-size:10px;color:var(--gold);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:4px}
.exp-role{font-family:'Playfair Display',serif;font-size:14px;margin-bottom:3px}
.exp-date{font-size:11px;color:var(--muted);font-family:'DM Mono',monospace;margin-bottom:8px}
.exp-bullets{list-style:none;font-size:11px;color:var(--muted);line-height:1.6}
.exp-bullets li::before{content:'→ ';color:var(--gold)}
.skills-wrap{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:2rem}
.skill-tag{border:0.5px solid var(--rule);border-radius:3px;padding:4px 10px;font-size:11px;font-family:'DM Mono',monospace;color:var(--muted);background:white}
.skill-tag.highlight{border-color:var(--gold-light);color:var(--gold);background:var(--tag-bg)}
.edu-row{display:flex;gap:1rem;margin-bottom:1.5rem}
.edu-item{flex:1;border:0.5px solid var(--rule);border-radius:5px;padding:0.75rem 1rem;background:var(--panel-bg);font-size:12px}
.edu-label{font-size:10px;font-family:'DM Mono',monospace;color:var(--gold);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:3px}
.edu-name{font-family:'Playfair Display',serif;font-size:13px;margin-bottom:2px}
.edu-status{font-size:11px;color:var(--muted)}
.bottom-cta{text-align:center;padding:2rem;border:0.5px solid var(--gold-light);border-radius:8px;background:var(--active-bg);margin-top:1rem}
.cta-text{font-family:'Playfair Display',serif;font-size:18px;margin-bottom:6px}
.cta-sub{font-size:12px;color:var(--muted);margin-bottom:16px;font-family:'DM Mono',monospace}
.cta-links{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.cta-link{display:inline-block;padding:8px 20px;border-radius:4px;font-size:12px;font-family:'DM Mono',monospace;text-decoration:none;transition:all 0.15s}
.cta-link.primary{background:var(--ink);color:var(--cream)}
.cta-link.secondary{border:0.5px solid var(--rule);color:var(--ink);background:white}
@media(max-width:600px){
  .pillars-grid,.law-scene,.exp-grid,.process-grid{grid-template-columns:1fr}
  .cv-header{grid-template-columns:auto 1fr}
  .cv-contact{display:none}
  .edu-row{flex-direction:column}
}
</style>
